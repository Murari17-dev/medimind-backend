# Supabase Postgres connection string (use the pooled connection on serverless hosts)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project URL and publishable (anon) key. Never use the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# OpenRouter vision model used to read prescriptions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free

# Comma-separated browser origins allowed to call this API (defaults to "*")
ALLOWED_ORIGINS=https://medimind-frontend-eta.vercel.app
